{
  "ConnectionStrings": {
    "Default": "Data Source=pireon.db"
  },
  "AllowedOrigins": "http://localhost:8081,http://localhost:3000",
  "FrontendAppUrl": "http://localhost:8081",
  "FrontendDataRoot": "../frontend/src/data",
  "AuthSettings": {
    "UseLdapAuthentication": false,
    "AllowLocalBreakGlass": true,
    "BreakGlassUsernames": "ADMIN",
    "AutoProvisionLdapUsers": false,
    "DefaultLdapRole": "viewer"
  },
  "CampusSettings": {
    "DefaultCampus": ""
  },
  "DemoData": {
    "Enabled": false
  },
  "DeliveryForm": {
    "Institution": "",
    "TemplatePath": "",
    "SofficePath": "",
    "ApplicationChecklist": {
      "Sections": []
    }
  },
  "MfaSettings": {
    "Issuer": "Pireon",
    "RequireForAdmins": true,
    "RequireForNonAdmins": false,
    "PendingMinutes": 10,
    "PeriodSeconds": 30,
    "Digits": 6,
    "WindowSteps": 6
  },
  "LdapSettings": {
    "Host": "ldap.example.com",
    "FallbackHost": "",
    "Port": 389,
    "Domain": "example",
    "BaseDn": "DC=example,DC=com",
    "UpnSuffixes": "example.com",
    "UseSsl": false,
    "TrustServerCertificate": false
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:8081,http://localhost:3000"
  },
  "SecuritySettings": {
    "ForceHttps": true,
    "EnableSwaggerInProduction": false,
    "DataProtectionKeysPath": "",
    "CookieSecurePolicy": "SameAsRequest",
    "CookieSameSite": "Lax",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: http: ws: wss:; font-src 'self' data: https:"
  },
  "PasswordPolicy": {
    "MinLength": 10,
    "MaxLength": 64,
    "DisallowCommonPasswords": true
  },
  "SessionSettings": {
    "IdleMinutes": 15,
    "WarningMinutes": 14,
    "RememberMeDays": 30
  },
  "BackupSettings": {
    "Enabled": true,
    "Path": "backups",
    "Cron": "",
    "IntervalHours": 24,
    "RetentionDays": 30
  },
  "NetworkTelemetrySettings": {
    "Enabled": false,
    "ExecutionMode": "agent",
    "AgentSharedPath": "../runtime/network-telemetry-agent",
    "AgentHeartbeatTimeoutSeconds": 30,
    "AutoScanEnabled": false,
    "AutoScanIntervalMinutes": 30,
    "AutoScanCron": "",
    "AutoScanCrons": "",
    "AutoScanTimeZone": "UTC",
    "DisplayTimeZone": "UTC",
    "DisplayLocale": "es-CL",
    "ScanCidrs": "",
    "MaxRangesPerScan": 12,
    "MaxHostsPerScan": 4096,
    "MaxConcurrentProbes": 96,
    "PortProbeConcurrency": 16,
    "ScanPorts": "135,139,445,3389,80,443,22,9100,631,515,53,88,389,161,5985,5986,8080,8443",
    "PingTimeoutMs": 250,
    "TcpTimeoutMs": 250,
    "DnsTimeoutMs": 1200,
    "FreshnessMinutes": 30,
    "RetentionDays": 90,
    "MaxSnapshots": 100,
    "IngestApiKey": "CHANGE_ME"
  },
  "PdfSettings": {
    "MaxUploadBytes": 25000000,
    "AllowedMimeTypes": "application/pdf,application/x-pdf"
  },
  "InventoryCategories": {
    "FallbackCategory": "other",
    "FallbackStatus": "active",
    "Categories": [
      { "Name": "pc", "Label": "PC", "Tokens": ["NOTEBOOK", "DESKTOP", "THINKPAD", "AIO", "OPTIPLEX"] },
      { "Name": "printer", "Label": "Impresora", "Tokens": ["IMPRESORA", "PRINTER"] },
      { "Name": "scanner", "Label": "Escaner", "Tokens": ["ESCANER", "SCANNER", "SCAN "] },
      { "Name": "other", "Label": "Otros", "Tokens": [] }
    ],
    "Statuses": [
      { "Name": "active", "Label": "Activo", "Tokens": [] },
      { "Name": "maintenance", "Label": "Mantenimiento", "Tokens": [] },
      { "Name": "inactive", "Label": "Inactivo", "Tokens": [] },
      { "Name": "stolen", "Label": "Robado", "Tokens": ["ROBADO"] },
      { "Name": "gap", "Label": "Brecha", "Tokens": ["BRECHA"] },
      { "Name": "retired", "Label": "Baja", "Tokens": ["BAJA"] }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


