@model Pireon.API.ViewModels.OrganizationSiteFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label fw-semibold">Nombre del sitio</label>
        <input name="Name" class="form-control" value="@Model.Name" required />
        <div class="form-text">Ej: Campus Providencia.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">CampusKey</label>
        <input name="CampusKey" class="form-control" value="@Model.CampusKey" required />
        <div class="form-text">Identificador unico usado por el mapa (se normaliza a slug).</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">School (prefijo de archivos)</label>
        <input name="School" class="form-control" value="@Model.School" />
        <div class="form-text">Prefijo del nombre de los archivos GeoJSON, ej: miColegio.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Zoom inicial</label>
        <input name="Zoom" class="form-control" value="@Model.Zoom" />
        <div class="form-text">Nivel de zoom del mapa (1 a 21).</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Zoom mínimo</label>
        <input name="MinZoom" class="form-control" value="@Model.MinZoom" />
        <div class="form-text">Zoom mínimo permitido en el mapa (0 a 21).</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Zoom máximo</label>
        <input name="MaxZoom" class="form-control" value="@Model.MaxZoom" />
        <div class="form-text">Zoom máximo permitido en el mapa (0 a 21).</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Latitud del centro</label>
        <input name="CenterLatitude" class="form-control" value="@Model.CenterLatitude" placeholder="-33.4489" />
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Longitud del centro</label>
        <input name="CenterLongitude" class="form-control" value="@Model.CenterLongitude" placeholder="-70.6693" />
    </div>
    <div class="col-12">
        <h6 class="fw-semibold mt-2 mb-2 text-muted text-uppercase small">Limites del mapa</h6>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold">Latitud minima</label>
        <input name="BoundsMinLatitude" class="form-control" value="@Model.BoundsMinLatitude" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold">Longitud minima</label>
        <input name="BoundsMinLongitude" class="form-control" value="@Model.BoundsMinLongitude" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold">Latitud maxima</label>
        <input name="BoundsMaxLatitude" class="form-control" value="@Model.BoundsMaxLatitude" />
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold">Longitud maxima</label>
        <input name="BoundsMaxLongitude" class="form-control" value="@Model.BoundsMaxLongitude" />
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Pisos (separados por coma)</label>
        <input name="FloorsCsv" class="form-control" value="@Model.FloorsCsv" placeholder="-1, 0, 1, 2" />
        <div class="form-text">Ej: -1, 0, 1, 2. El primer piso sera el predeterminado.</div>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold">Piso predeterminado</label>
        <input name="DefaultFloor" class="form-control" value="@Model.DefaultFloor" placeholder="0" />
        <div class="form-text">Piso que se muestra al abrir el sitio en el mapa.</div>
    </div>
</div>
