@using System.Text.Json
@{
    ViewData["Title"] = "Sitios y usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var organization = (Pireon.API.Models.Organization)ViewBag.Organization;
    var sites = (List<Pireon.API.Models.CampusSite>)ViewBag.Sites;
    var users = (IEnumerable<dynamic>)ViewBag.Users;

    static string FloorsToCsv(string floorsJson)
    {
        if (string.IsNullOrWhiteSpace(floorsJson))
        {
            return string.Empty;
        }

        try
        {
            var floors = JsonSerializer.Deserialize<List<string>>(floorsJson) ?? new List<string>();
            return string.Join(", ", floors);
        }
        catch
        {
            return string.Empty;
        }
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">@organization.Name</h2>
        <div class="text-muted">
            <code>@organization.Slug</code>
            @if (!string.IsNullOrWhiteSpace(organization.ContactEmail))
            {
                <text>&middot; @organization.ContactEmail</text>
            }
            @if (organization.IsActive)
            {
                <span class="badge text-bg-success ms-1">Activa</span>
            }
            else
            {
                <span class="badge text-bg-secondary ms-1">Inactiva</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/organizations" class="btn btn-secondary shadow-sm fw-semibold px-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <a href="/admin/organizations/@organization.Id/sites/create" class="btn btn-primary shadow-sm fw-semibold px-3">
            <i class="bi bi-plus-lg me-1"></i> Nuevo sitio
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold py-3">
                <i class="bi bi-geo-alt me-2"></i>Sitios (@sites.Count)
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>CampusKey</th>
                            <th>Pisos</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var site in sites)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @site.Name
                                    @if (!string.IsNullOrWhiteSpace(site.School))
                                    {
                                        <div class="small text-muted">@site.School</div>
                                    }
                                </td>
                                <td><code>@site.CampusKey</code></td>
                                <td class="small">@FloorsToCsv(site.FloorsJson)</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" href="/admin/organizations/@organization.Id/sites/@site.Id/edit" title="Editar y planos">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="/admin/organizations/@organization.Id/sites/@site.Id/delete" class="d-inline" onsubmit="return confirm('¿Eliminar el sitio @site.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!sites.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Aun no hay sitios para esta organizacion.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent fw-semibold py-3">
                <i class="bi bi-people me-2"></i>Admins de la organizacion (@users.Count())
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@user.Username</div>
                                    <div class="small text-muted">@user.Role</div>
                                </td>
                                <td class="text-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge text-bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!users.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted py-4">Sin usuarios asignados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent fw-semibold py-3">
                <i class="bi bi-person-plus me-2"></i>Crear admin de organizacion
            </div>
            <div class="card-body">
                <form method="post" action="/admin/organizations/@organization.Id/admin-users">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de usuario</label>
                        <input name="username" class="form-control" required autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contrasena</label>
                        <input name="password" type="password" class="form-control" required autocomplete="new-password" />
                        <div class="form-text">El usuario tendra rol admin y administrara solo los datos de esta organizacion.</div>
                    </div>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-check-lg me-1"></i> Crear admin
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
