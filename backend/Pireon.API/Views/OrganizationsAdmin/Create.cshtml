@model Pireon.API.Models.Organization
@{
    ViewData["Title"] = "Nueva organizacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Nueva organizacion</h2>
        <div class="text-muted">Registra un cliente y luego crea sus sitios (campus).</div>
    </div>
    <a href="/admin/organizations" class="btn btn-secondary shadow-sm fw-semibold px-3">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nombre</label>
                    <input name="Name" class="form-control" value="@Model.Name" required />
                    <div class="form-text">Ej: Colegio San Ignacio.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Slug</label>
                    <input name="Slug" class="form-control" value="@Model.Slug" placeholder="Auto-generado" />
                    <div class="form-text">Identificador unico. Dejalo vacio para generarlo automaticamente.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email de contacto</label>
                    <input name="ContactEmail" type="email" class="form-control" value="@Model.ContactEmail" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Notas</label>
                    <input name="Notes" class="form-control" value="@Model.Notes" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-check-lg me-1"></i> Crear organizacion
                </button>
            </div>
        </form>
    </div>
</div>
