@model Pireon.API.ViewModels.OrganizationSiteFormViewModel
@{
    ViewData["Title"] = "Nuevo sitio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Nuevo sitio</h2>
        <div class="text-muted">Configura la geometria del campus (centro, zoom y limites del mapa).</div>
    </div>
    <a href="/admin/organizations/@Model.OrganizationId/sites" class="btn btn-secondary shadow-sm fw-semibold px-3">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post" asp-action="CreateSite">
            @Html.AntiForgeryToken()
            <partial name="_SiteForm" model="Model" />

            <div class="mt-4">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-check-lg me-1"></i> Crear sitio
                </button>
            </div>
        </form>
    </div>
</div>
