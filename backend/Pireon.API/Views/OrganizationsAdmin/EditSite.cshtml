@model Pireon.API.ViewModels.OrganizationSiteFormViewModel
@{
    ViewData["Title"] = "Editar sitio";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var site = (Pireon.API.Models.CampusSite?)ViewBag.Site;
    var floors = (List<string>?)ViewBag.Floors ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Editar sitio</h2>
        <div class="text-muted"><code>@Model.CampusKey</code></div>
    </div>
    <a href="/admin/organizations/@Model.OrganizationId/sites" class="btn btn-secondary shadow-sm fw-semibold px-3">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="post" asp-action="EditSite" asp-route-siteId="@Model.SiteId">
            @Html.AntiForgeryToken()
            <partial name="_SiteForm" model="Model" />

            <div class="mt-4">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-check-lg me-1"></i> Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@if (site is not null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent fw-semibold py-3">
            <i class="bi bi-map me-2"></i>Planos GeoJSON por piso
        </div>
        <div class="card-body">
            @if (floors.Count == 0)
            {
                <div class="text-muted">Define al menos un piso en el formulario superior para poder subir planos.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Piso</th>
                                <th>Archivo esperado</th>
                                <th>Subir plano</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var floor in floors)
                            {
                                var school = string.IsNullOrWhiteSpace(site.School) ? site.CampusKey : site.School;
                                var expectedFile = $"{school}_{site.CampusKey}_{floor.Trim()}.json";
                                <tr>
                                    <td class="fw-semibold">@floor</td>
                                    <td><code>@expectedFile</code></td>
                                    <td>
                                        <form method="post" enctype="multipart/form-data" action="/admin/organizations/@Model.OrganizationId/sites/@site.Id/floors/@floor/geojson">
                                            @Html.AntiForgeryToken()
                                            <div class="d-flex gap-2">
                                                <input type="file" name="file" accept=".json,.geojson" class="form-control form-control-sm" required />
                                                <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                                                    <i class="bi bi-upload me-1"></i> Subir
                                                </button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-text mt-2">
                    El archivo se guarda en el data root del frontend con el nombre que consume el mapa.
                </div>
            }
        </div>
    </div>
}
