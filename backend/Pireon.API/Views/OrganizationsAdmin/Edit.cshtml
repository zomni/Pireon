@model Pireon.API.Models.Organization
@{
    ViewData["Title"] = "Editar organizacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Editar organizacion</h2>
        <div class="text-muted"><code>@Model.Slug</code></div>
    </div>
    <a href="/admin/organizations" class="btn btn-secondary shadow-sm fw-semibold px-3">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nombre</label>
                    <input name="Name" class="form-control" value="@Model.Name" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email de contacto</label>
                    <input name="ContactEmail" type="email" class="form-control" value="@Model.ContactEmail" />
                </div>
                <div class="col-md-12">
                    <label class="form-label fw-semibold">Notas</label>
                    <textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input name="IsActive" class="form-check-input" type="checkbox" value="true" checked="@Model.IsActive" />
                        <label class="form-check-label">Organizacion activa</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Color identificador</label>
                    <div class="input-group">
                        <input id="organization-color-picker" type="color" class="form-control form-control-color" value="@(string.IsNullOrWhiteSpace(Model.Color) ? "#6c757d" : Model.Color)" title="Elegir color" oninput="document.getElementById('organization-color-text').value = this.value" />
                        <input id="organization-color-text" name="Color" class="form-control" value="@Model.Color" placeholder="#0d6efd" oninput="document.getElementById('organization-color-picker').value = this.value" onchange="document.getElementById('organization-color-picker').value = this.value" />
                    </div>
                    <div class="form-text">El badge de la organizacion en las paginas de administracion usara este color.</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                    <i class="bi bi-check-lg me-1"></i> Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>
