@model IEnumerable<Pireon.API.ViewModels.OrganizationIndexViewModel>
@{
    ViewData["Title"] = "Organizaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Organizaciones</h2>
        <div class="text-muted">Clientes y sus sitios (campus). Solo visible para el superadministrador.</div>
    </div>
    <a href="/admin/organizations/create" class="btn btn-primary shadow-sm fw-semibold px-3">
        <i class="bi bi-plus-lg me-1"></i> Nueva organizacion
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Color</th>
                    <th>Slug</th>
                    <th>Contacto</th>
                    <th class="text-center">Sitios</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var org in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @if (!string.IsNullOrWhiteSpace(org.Color))
                            {
                                <span class="badge border me-2" style="background-color: @org.Color; color: @Pireon.API.Services.OrganizationColorPalette.ReadableText(org.Color); border-color: @org.Color;">&nbsp;</span>
                            }
                            @org.Name
                        </td>
                        <td><code>@(string.IsNullOrWhiteSpace(org.Color) ? "-" : org.Color)</code></td>
                        <td><code>@org.Slug</code></td>
                        <td>@org.ContactEmail</td>
                        <td class="text-center">@org.SitesCount</td>
                        <td class="text-center">
                            @if (org.IsActive)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="/admin/organizations/@org.Id/sites" title="Sitios y usuarios">
                                <i class="bi bi-geo-alt"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" href="/admin/organizations/@org.Id/edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="/admin/organizations/@org.Id/delete" class="d-inline" onsubmit="return confirm('¿Eliminar la organizacion @org.Name y sus sitios?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aun no hay organizaciones.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
